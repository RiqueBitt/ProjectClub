<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Project Club — quem está online". updatePeriodMillis = 30 min
     (o mínimo que o Android aceita); o app também atualiza ao abrir/fechar. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_online_description"
    android:initialLayout="@layout/widget_online"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:previewLayout="@layout/widget_online"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
