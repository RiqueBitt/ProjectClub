# Dependências (reinstaladas via npm install/CI, nunca versionadas)
node_modules/
**/node_modules/

# Segredos — NUNCA versionar. Só os .env.example (sem valores reais) ficam.
.env
.env.local
**/.env
**/.env.local

# BUG DE SEGURANÇA CORRIGIDO: essa pasta (certificados TLS do MySQL/Redis
# — chave privada incluída) estava sendo versionada desde o primeiro
# commit, apesar da documentação em .env.example sempre ter dito o
# contrário. Se você já tinha dado push pra algum lugar antes dessa
# correção, considere os certificados antigos COMPROMETIDOS — troque-os
# de novo na Square Cloud (gera um .zip novo, senha e certificados
# mudam juntos) mesmo já tendo trocado antes.
server/certs/

# Builds/saídas geradas
client/dist/
desktop/dist/
desktop/out/

# Arquivos enviados por usuários (armazenamento local, não faz sentido versionar)
server/uploads/

# Logs
npm-debug.log*
*.log

# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

