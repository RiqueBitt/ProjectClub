# Dependências (reinstaladas via npm install/CI, nunca versionadas)
node_modules/
**/node_modules/

# Segredos — NUNCA versionar. Só os .env.example (sem valores reais) ficam.
.env
.env.local
**/.env
**/.env.local

# BUG DE SEGURANÇA CORRIGIDO: essa pasta (certificados TLS do MySQL/Redis
# — chave privada incluída) estava sendo versionada desde o primeiro
# commit, apesar da documentação em .env.example sempre ter dito o
# contrário. Se você já tinha dado push pra algum lugar antes dessa
# correção, considere os certificados antigos COMPROMETIDOS — troque-os
# de novo na Square Cloud (gera um .zip novo, senha e certificados
# mudam juntos) mesmo já tendo trocado antes.
server/certs/

# Builds/saídas geradas
client/dist/
desktop/dist/
desktop/out/

# Arquivos enviados por usuários (armazenamento local, não faz sentido versionar)
server/uploads/

# Backups do banco gravados em disco (services/dbBackup.js) — dados reais
server/backups/

# Praça (Club Penguin): cache em disco da mídia do jogo (baixada do B2),
# configurações e mods locais. Nunca versionar — 1,7 GB.
server/data/waddle/

# Logs
npm-debug.log*
*.log

# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Android (Capacitor) — pastas geradas/locais, nunca versionadas
client/android/app/build/
client/android/build/
client/android/.gradle/
client/android/local.properties
client/android/app/*.keystore
client/android/app/*.jks
client/android/captures/
client/android/.cxx/

# Desktop (Electron) — build gerado
desktop/dist/
desktop/out/

# Saídas dos testes de tela (Playwright)
client/test-results/
client/playwright-report/
server/reports/

# OpenVPN embutido no app de Windows (baixado e conferido pelo CI)
desktop/vendor/openvpn/*.msi

# Club Penguin embutido no app de PC (gerado por desktop/scripts/prepare-waddle.js a cada build)
desktop/vendor/waddle/
