# ===== Servidor de mídia do Project Club (copie para .env) =====
# Domínio apontando (DNS A) pro IP do VPS — o Caddy emite o TLS sozinho.
MEDIA_DOMAIN=media.seudominio.com
# IP público do VPS (anunciado nos candidatos ICE).
MEDIA_PUBLIC_IP=203.0.113.10
# Segredo compartilhado com o Project Club (MEDIA_SERVER_SECRET lá). Gere um
# longo e aleatório: openssl rand -hex 32
MEDIA_SERVER_SECRET=troque-por-um-segredo-longo
# Segredo do TURN (TURN_SECRET no Project Club também). openssl rand -hex 32
TURN_SECRET=troque-por-outro-segredo-longo
# Porta interna da sinalização (o Caddy publica em 443).
MEDIA_PORT=4443
# Faixa de portas de mídia (abra no firewall, UDP e TCP).
MEDIA_RTC_MIN_PORT=40000
MEDIA_RTC_MAX_PORT=40999
# Workers = CPUs por padrão. Nível de log: error | warn | debug
MEDIA_LOG_LEVEL=warn
# WebRtcServer: cada worker escuta UMA porta UDP+TCP (40000, 40001, ...) e os
# transports avulsos usam o resto da faixa (40016+). 0 = desliga.
MEDIA_WEBRTC_SERVER=1
# Teto de entrada por transport (bps). 3 Mbps = mic + câmera + tela 1080p.
MEDIA_MAX_INCOMING_BITRATE=3000000
# Relay do coturn (abra no firewall, UDP).
TURN_MIN_PORT=49152
TURN_MAX_PORT=49999
# TURN sobre TLS (5349/tcp) — preenchido pelo scripts/vm-voz-robusta.sh
# depois de copiar o certificado do Caddy pra ./certs. Vazio = sem TLS.
TURN_TLS_ARGS=
# TURN também na porta 443 (opcional — ver README "TURN na porta 443"). O
# scripts/vm-voz-robusta.sh com TURN_443=1 preenche as duas linhas abaixo.
# TURN_DOMAIN=turn-38-92-41-54.sslip.io
# COMPOSE_FILE=docker-compose.yml:docker-compose.turn443.yml
