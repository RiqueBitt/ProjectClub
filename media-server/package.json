{
  "name": "project-club-media-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de mídia próprio do Project Club (SFU mediasoup + sinalização WebSocket). Roda num VPS com IP público e portas UDP abertas.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "MEDIA_LOG_LEVEL=debug node --watch src/index.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e-webrtc.mjs"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "mediasoup": "^3.29.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
