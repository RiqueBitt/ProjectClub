# Token da API da Shard Cloud (Dashboard → Config → Integrações)
SHARDCLOUD_API_KEY=
# Segredo que protege ESTE servidor MCP. Gere com: openssl rand -hex 24
# O Claude conecta em https://<subdomínio>.shardweb.app/mcp/<MCP_TOKEN>
MCP_TOKEN=
# Opcional: token do GitHub pra baixar repositórios privados no deploy_from_github
GITHUB_TOKEN=
# Porta (a Shard Cloud define PORT sozinha)
PORT=80
