{
  "name": "project-club-server",
  "version": "1.0.0",
  "description": "Backend API + realtime server for the Discord-like communication platform",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "predev": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma db push --skip-generate",
    "dev": "node --watch src/index.js",
    "start": "node scripts/write-certs-from-env.js && node scripts/wait-for-db.js && node src/index.js",
    "prisma:generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "prisma:push": "node scripts/write-certs-from-env.js && node scripts/prisma-push-with-retry.js",
    "prisma:seed": "node prisma/seed.js",
    "postinstall": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "test": "node --test"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "agora-token": "^2.0.5",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@prisma/client": "5.20.0",
    "firebase-admin": "^14.5.0",
    "compression": "^1.8.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "otplib": "^13.4.0",
    "prisma": "5.20.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.3",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
