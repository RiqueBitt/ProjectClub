{
  "name": "project-club-server",
  "version": "1.0.0",
  "description": "Backend API + realtime server for the Discord-like communication platform",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "predev": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma db push --skip-generate",
    "dev": "nodemon src/index.js",
    "start": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma db push --skip-generate && node src/index.js",
    "prisma:generate": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "prisma:push": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma db push --accept-data-loss --skip-generate && prisma generate && node prisma/seed.js",
    "prisma:seed": "node prisma/seed.js",
    "postinstall": "PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate",
    "test": "node --test"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "agora-token": "^2.0.5",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@prisma/client": "5.20.0",
    "firebase-admin": "^12.7.0",
    "compression": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.0",
    "prisma": "5.20.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.3",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
