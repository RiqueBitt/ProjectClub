# Modelo de variáveis de ambiente — copie pra .env e preencha com valores
# de verdade. NUNCA cometa o .env real (com segredos) no controle de
# versão — só este arquivo de exemplo.

NODE_ENV=production
CLIENT_ORIGIN=https://seusite.exemplo.com

# ---------- MySQL — fonte de verdade de TODOS os dados permanentes
# (contas, mensagens, canais, cargos, convites, badges, níveis, likes,
# amizades, configurações). Qualquer provedor gerenciado serve
# (PlanetScale, Railway, RDS, Square Cloud, etc). ----------
DATABASE_URL=mysql://usuario:senha@host:3306/nome_do_banco
# BUG CORRIGIDO na documentação abaixo (não no código): a Square Cloud
# na verdade entrega UM certificado só (não três) — confirmado na
# própria documentação oficial deles
# (docs.squarecloud.app/pt-br/api-reference/endpoint/databases/create):
# a resposta de "Criar Banco de Dados" tem só um campo "certificate",
# não um trio cert/key/ca. Guarde esse único arquivo em
# server/certs/mysql/ca.pem (a pasta já está no .gitignore, nunca vai
# pro controle de versão) e use só sslca (não sslcert/sslkey) na URL:
#   ?sslca=.../ca.pem&sslaccept=accept_invalid_certs
# (sslaccept=accept_invalid_certs é necessário pra certificados
# autoassinados/gerados de forma simples, como os do Square Cloud — sem
# isso o Prisma recusa a conexão mesmo com o certificado certo)
# IMPORTANTE sobre caminho relativo vs absoluto: o comando `prisma db
# push`/`migrate` resolve caminho relativo a partir da pasta do
# schema.prisma (server/prisma/), mas o Prisma Client em tempo de
# execução — o que o app de verdade usa pra rodar — resolve relativo à
# pasta de onde o PROCESSO roda, que pode ser diferente. Isso significa
# que um caminho relativo que funciona no `db push` pode dar "no such
# file" quando o app sobe de verdade. Pra evitar essa armadilha, use
# caminho ABSOLUTO (funciona igual nos dois casos) — ex., no Square
# Cloud, o app roda em /application/server, então:
#   ?sslca=/application/server/certs/mysql/ca.pem&sslaccept=accept_invalid_certs
# (troque "/application/server" pelo caminho real do seu provedor)
# ATENÇÃO: a senha e o certificado só aparecem UMA VEZ na hora de criar
# o banco na Square Cloud — salve os dois na hora, não dá pra recuperar
# depois (só redefinir do zero, invalidando a senha antiga).

# ---------- Redis — presença online/offline, quem está em cada canal de
# voz, cache de consultas caras, rate limiting, filas e tudo que expira
# sozinho. NUNCA armazena dado permanente — isso é sempre o MySQL acima.
# Upstash/Redis Cloud/ElastiCache, qualquer um serve. ----------
REDIS_URL=rediss://default:senha@host:porta
# BUG CORRIGIDO na documentação abaixo (mesmo motivo do MySQL acima): é
# UM certificado só, não três — a Square Cloud devolve isso na criação
# do banco. Guarde-o em server/certs/redis/ca.pem (pasta já no
# .gitignore) e use rediss:// (com "s", TLS) na URL acima. Caminho
# ABSOLUTO de novo, mesma lição do MySQL:
REDIS_CA_PATH=/application/server/certs/redis/ca.pem
# Só preencha os dois abaixo se o SEU provedor especificamente exigir
# TLS mútuo de verdade (cliente + servidor) — a Square Cloud não exige,
# então pra ela deixe as duas linhas em branco/apagadas.
REDIS_CERT_PATH=
REDIS_KEY_PATH=

# ---------- Backblaze B2 — armazenamento de TODO arquivo enviado por
# usuário (fotos de perfil, banners, anexos de mensagem, GIFs, áudio,
# qualquer upload). Crie um bucket + uma Application Key em
# https://www.backblaze.com/b2/cloud-storage.html — sem essas variáveis
# preenchidas, os uploads caem automaticamente pro disco local (modo de
# desenvolvimento, sem precisar de conta no B2). ----------
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=nome-do-seu-bucket
B2_KEY_ID=
B2_APPLICATION_KEY=
# "Friendly URL" que aparece na tela do bucket no painel do B2 (ou o
# domínio do seu CDN, se tiver um na frente do bucket).
B2_PUBLIC_URL=https://f004.backblazeb2.com/file/nome-do-seu-bucket

# ---------- Autenticação — gere segredos fortes de verdade, únicos
# (ex.: `openssl rand -hex 32`), nunca use os valores de exemplo em
# produção. ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------- E-mail (verificação de conta, redefinição de senha) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@seusite.exemplo.com

# ---------- Outros ----------
# Modo antigo (disco local) usado só quando B2_* acima não estiverem
# preenchidos — mantido como rede de segurança pro ambiente de
# desenvolvimento.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25
PLATFORM_ADMIN_EMAIL=

# ---------- Sistema de Mods (Apps → Mods) ----------
# Chave de API "read-only" do mod.io — crie um game profile em
# https://mod.io/ (painel de desenvolvedor) e pegue a api_key dele. Sem
# essa variável, as rotas /api/mods/* respondem 503; o resto da
# plataforma continua funcionando normalmente.
MODIO_API_KEY=
MODIO_API_BASE=https://api.mod.io/v1

# Chave pública da Steamworks Web API (Steam Workshop — Terraria/
# tModLoader, Payday 2, Payday 3, etc). Gere de graça em
# https://steamcommunity.com/dev/apikey — sem essa variável, as rotas
# /api/workshop/* respondem 503; o resto da plataforma continua normal.
STEAM_WEB_API_KEY=

# Segredo compartilhado só pro GitHub Actions publicar uma "Atualização" automaticamente (ver server/src/routes/system.js) — gerado, nunca escolhido à mão.
CI_UPDATE_SECRET=

# Chave de conta de serviço do Firebase (JSON inteiro, numa linha só) — necessário só pra push notification funcionar no Android com o app fechado. Ver README_PUSH.md pra como gerar.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Agora.io (chamadas de voz) — App ID e App Certificate, pegos em
# console.agora.io → seu projeto → "Manage credentials". O App
# Certificate NUNCA deve ser exposto no cliente, só fica aqui.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
